{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/home",
      "destination": "/vista/home.html"
    },
    {
      "source": "/coches",
      "destination": "/vista/coches.html"
    },
    {
      "source": "/configurador",
      "destination": "/vista/configurador.html"
    },
    {
      "source": "/(.*)",
      "destination": "/vista/$1"
    }
  ]
}
